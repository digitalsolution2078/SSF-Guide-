# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://ssf:ssf@localhost:5432/ssf_guide?schema=public"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google Gemini API (Ask SSF AI chatbot — Stage 4)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Email notifications (Resend or SMTP)
RESEND_API_KEY=""

# CAPTCHA (Turnstile)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Public site
NEXT_PUBLIC_SITE_URL="https://ssf.digitalsolutionnepal.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="9779705433699"

# Optional: override the Gemini model (default: gemini-flash-latest)
GEMINI_MODEL=""

# Web Push (browser notifications). Generate with: npx web-push generate-vapid-keys
# Public key can also be set client-side via NEXT_PUBLIC_VAPID_PUBLIC_KEY (a default ships in code).
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:mail@digitalsolutionnepal.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
